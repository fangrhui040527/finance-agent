# Batch files must keep CRLF: a .bat with LF endings breaks label jumps on some
# Windows shells, and the failure looks like "the command does nothing".
*.bat text eol=crlf
*.cmd text eol=crlf

# Everything else stays LF, including on Windows checkouts.
*.py   text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.html text eol=lf
Makefile text eol=lf

# The corpus as git carries it (knowledge/stores.py). A part after the first
# has no SQLite header, so nothing marks it binary but this line - and a text
# conversion on a Windows checkout would corrupt it. The manifest has one
# writer; a merge that combined two of them would describe neither.
data/stores/*/part-* binary
data/stores/*/manifest.json text eol=lf -merge
