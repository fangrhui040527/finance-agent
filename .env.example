# Copy to .env. Never commit .env.
#
# SECRETS AND SERVICE CREDENTIALS ONLY. Settings live in config.toml - risk
# limits, budgets, markets, the FX planning rate. Anything that belongs in
# version control belongs there, not here.
#
# These are local dev credentials, not secrets, and are not reused anywhere real.

POSTGRES_USER=finplanet
POSTGRES_PASSWORD=devonly
POSTGRES_DB=finplanet
NEO4J_PASSWORD=devonlypass
MINIO_USER=finplanet
MINIO_PASSWORD=devonlypass

# Inference. Keys live here or in a vault, never in git.
#
# This IS now read. core/llm/backends.py selects AnthropicBackend when it is set
# and EchoBackend when it is not - and `python ask.py backend` prints which one
# is active and why. A system that quietly ran on the deterministic stub for a
# week would be indistinguishable from one that worked, so check it after
# setting this.
ANTHROPIC_API_KEY=

# Required ONLY for an identity-linked key, which is scoped to a workspace: the
# API rejects every request that does not name one, with
# "anthropic-workspace-id is required when authenticating with an
# identity-linked API key". Leave blank for an ordinary key - sending a
# workspace a key does not have is its own error. The id is in the Console URL
# under Settings -> Workspaces. `python ask.py backend` names the workspace it
# will bill.
ANTHROPIC_WORKSPACE_ID=

# Force a backend regardless of the key: 'anthropic', 'echo', 'free', or one of
# the free providers below. Leave unset to let the keys decide: ANTHROPIC_API_KEY
# first, then the first free-provider key that is set, then echo. 'echo' is how
# you work offline with a key in the file.
LLM_BACKEND=

# --- Free providers (docs/21) ------------------------------------------------
# The reasoning already runs on your Claude session (docs/15, docs/20) at no
# per-token cost. These move the calls this process makes ITSELF - triage,
# tagging, dedup, classification, and the CLI's narratives - onto an
# open-weight model on a permanent free tier, so the first month of knowledge
# building bills nothing to the Anthropic API. One key is enough; `python
# ask.py backend --list` shows every provider, its models and which keys are
# set, and `python ask.py backend` says which one will answer.
#
# Catalogued from github.com/12britz/awesome-free-models (2026-09-03). Free
# lineups rotate: when a default model 404s, the error names LLM_MODEL_<TIER>.
#
#   GROQ_API_KEY         console.groq.com - Llama, Qwen, GPT-OSS; ~30/min, no card
#   GEMINI_API_KEY       aistudio.google.com - Gemini Flash / Flash-Lite; no card
#   OPENROUTER_API_KEY   openrouter.ai - ':free' models; 20/min, ~50/day; $0 balance ok
#   MISTRAL_API_KEY      console.mistral.ai - 1 req/s; phone verification
#   NVIDIA_API_KEY       build.nvidia.com - 100+ hosted open models; ~40/min
#   (ollama)             keyless, local: LLM_BACKEND=ollama; LLM_BASE_URL for another host
#   (openai-compatible)  any endpoint: LLM_BACKEND=openai-compatible + LLM_BASE_URL
#                        (+ LLM_API_KEY if it wants one; LLM_MODEL for the models)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=

# Which model a provider serves per tier, when its default is not the one you
# want or has been retired. LLM_MODEL alone pins all three.
LLM_MODEL=
LLM_MODEL_REASON=
LLM_MODEL_BALANCED=
LLM_MODEL_CHEAP=

# A different backend per tier. The month-one shape: the thesis and red team
# on Claude (your session over MCP, or the API when unattended), everything
# cheap on a free model.
#   LLM_BACKEND_CHEAP=groq
# Unset = the tier uses LLM_BACKEND's choice. Ignored by `ask.py backend --use`.
LLM_BACKEND_REASON=
LLM_BACKEND_BALANCED=
LLM_BACKEND_CHEAP=

# --- Model and reasoning -----------------------------------------------------
# Two dials, deliberately independent. The tier router (core/llm/tiers.py) picks
# a model from what the call is FOR; these override that pick and how hard the
# model thinks. `python ask.py backend` prints the resolved table, and every
# surface that names a backend names the selection too - a run that quietly
# thought at 'low' because a shell still had the variable exported would be
# indistinguishable from one that thought hard.
#
# Pin every Messages tier to one model: haiku | sonnet | opus, or the exact id
# (claude-haiku-4-5 | claude-sonnet-5 | claude-opus-5). Unset lets the task
# class route it, which is the cheaper default: triage on Haiku, a thesis on
# Opus. FINPLANET_CHEAP=1 still works and means exactly FINPLANET_MODEL=haiku.
# On a free provider the pin still lands on that TIER - `cheap` pins everything
# to the provider's cheap model - and the effort dial below is not sent at all.
FINPLANET_MODEL=

# How hard the model thinks: low | medium | high | xhigh | max - Claude's own
# five levels, sent as output_config.effort. Unset leaves each tier on its
# default (reason high, balanced medium, cheap none).
#
# Haiku 4.5 has NO effort parameter and returns a 400 for one, so on that model
# the same five levels become a thinking budget of matching size (low 1,024 ->
# max 16,000 tokens). The dial reaches all three models; only its shape changes.
# Raising effort also raises the output cap it lands in, because thinking that
# gets truncated is billed and returned as an exception.
#
# Per command instead of per shell: `python ask.py --model opus --effort max why ...`
FINPLANET_EFFORT=

# --- Sources -----------------------------------------------------------------
# The widest source in the register - GDELT, 100+ languages, worldwide - needs
# no key at all, which is why it is the one that got wired first.
#
# Keys for sources NOT yet wired are deliberately absent from this file. A key
# that sets nothing reads as configured, and that is worse than a missing key.
# They live in docs/world-sources.html until the code that reads them exists.

# Sent as User-Agent when polling GDELT. Optional there, and the adapter has a
# working default - but put a real contact address in it, because the same
# courtesy is MANDATORY at SEC EDGAR, which returns 403 without one.
GDELT_USER_AGENT=

# Where the GDELT DOC API lives. Leave unset for https. Measured 2026-08-31:
# from one network the host answers on port 80 and times out on 443. Setting
# this to http://api.gdeltproject.org/api/v2/doc/doc restores the feed there,
# at the cost of transport integrity - headlines could be altered in flight.
# Prefer fixing the network; use this only when you cannot.
GDELT_DOC_API=

# --- Keyed data providers (knowledge/sources/) -------------------------------
# Each is read by exactly one collector, which skips itself - recorded as
# `skipped`, with the variable named - while the key is absent. In GitHub
# Actions these are repository secrets of the SAME names; collect.yml passes
# them through. Free tiers, all four:
#
#   FINNHUB_API_KEY       finnhub.io - US company news with summaries, insider
#                         transactions, earnings calendar and surprises,
#                         recommendation trends, basic financials. 60/min.
#   FMP_API_KEY           financialmodelingprep.com - quarterly statements,
#                         analyst estimates, price-target consensus, rating
#                         changes, call transcripts. 250/day.
#   ALPHAVANTAGE_API_KEY  alphavantage.co - NEWS_SENTIMENT, one call a day for
#                         the US names. 25/day, which is why it is one call.
#   FRED_API_KEY          fred.stlouisfed.org - Fed funds, yields, CPI,
#                         unemployment, VIX, dollar, MYR/USD. Generous.
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact address, or it
# answers 403. Falls back to GDELT_USER_AGENT, then to the project default.
#   SEC_USER_AGENT=finplanet-analyst-mind you@example.com
SEC_USER_AGENT=

# Daily price bars come from Stooq (core/market/feed.py): free, no key, no quota,
# which is why it is the price source wired first. Nothing to configure - it is
# listed here so the absence of a key is a recorded decision rather than an
# oversight. Coverage is per-market: `python ask.py prices XNAS:NVDA` verifies a
# market in one call, and an unmapped market raises rather than guessing a
# suffix and returning another company's prices.

# --- Taiwan, read-only (details/09) --------------------------------------------
# FinMind (finmindtrade.com) answers 300 requests an hour with no token and 600
# with a free one. Optional: the finmind collector runs without it.
FINMIND_TOKEN=

# --- Statements behind an optional key (details/09) -----------------------------
# EODHD (eodhd.com) fundamentals: quarterly and annual statements for 60+
# exchanges including Bursa. Free plan: 20 credits a day, a fundamentals call
# costs 10, US only - so two names a day, rotated. The Fundamentals plan lifts
# both and covers KLSE. Optional: the eodhd collector skips without it.
EODHD_API_KEY=

# --- The retrieval embedder (knowledge/retrieval/embedding.py) -------------------
# Optional, and the single largest lever on search quality this system has.
#
# Without a key the default is DistributionalEmbedder, fitted on the corpus's own
# word company. It only relates words it has SEEN, which is exactly why the
# plain-English half of the labelled set fails: ask about a "bendable" phone when
# every article says "foldable" and it reaches nothing. A real embedding model
# relates them. `ask.py retrieval --embedder api` scores it against the same 24
# questions so the difference is measured, never assumed.
#
# Three free, OpenAI-schema routes, in the order they were assessed. The seam
# takes any of them - it POSTs {"model", "input"} and reads data[].embedding -
# so switching provider is these three variables and no code.
#
#   1. OpenRouter (assessed 2026-09-08, the one wired):
#        URL   https://openrouter.ai/api/v1/embeddings
#        MODEL nvidia/nemotron-3-embed-1b:free      - zero cost per token
#      Known trap, and the reason this seam is safe: OpenRouter answers HTTP 200
#      with an EMPTY data array for a model that cannot serve the requested
#      encoding, and the OpenAI SDK defaults to encoding_format=base64. This
#      client is raw urllib, never sets encoding_format, and RAISES when the
#      response holds fewer vectors than it asked for - so the failure surfaces
#      instead of filling the index with zeros. Free models carry low daily rate
#      limits; the first index is ~1,100 chunks and every one after is cached.
#
#   2. Cloudflare Workers AI - 10,000 Neurons/day, no credit card. Serves BGE
#      embedding models. Its OpenAI-compatible route is under the account path,
#      so EMBEDDING_API_URL carries the account id.
#
#   3. Hugging Face router (https://router.huggingface.io/v1/embeddings) -
#      OpenAI-compatible, but free users get $0.10/month of credits rather than
#      a free model, so it meters out. A fallback, not a home.
#
# Vectors are cached in data/embeddings.db by (model, text), so a nightly
# re-index of unchanged headlines costs nothing and switching model never reads
# back the old model's vectors.
EMBEDDING_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=
