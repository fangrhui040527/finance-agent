.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
# Anchored to the repository root on purpose. An unanchored `data/` matches ANY
# directory of that name at any depth, which silently excluded the three
# human-authored yaml files under knowledge/graph/data/ - checked-in sources the
# graph build reads, not generated output.
/data/
*.db
config.local.toml
.coverage
htmlcov/

# Traces. These hold VERBATIM prompts, model responses and whatever portfolio
# positions were passed in - a debugging artefact, not an audit record. The
# provenance ledger is the thing that keeps history, and it stores a prompt hash
# rather than the prompt for exactly this reason.
debug/

# Tooling that must never enter a commit. A `npm ls` run in this directory
# creates node_modules/ and `git add -A` sweeps it in - 368,000 lines of
# vendored JavaScript that would live in the history forever.
node_modules/
package-lock.json
